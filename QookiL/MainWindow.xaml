<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QookiL.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:QookiL"
    mc:Ignorable="d"
    Title="QookiL">

    <Grid>
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="14"/>
            </Style>
            <Style x:Key="CardHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Style>
            <Style x:Key="ToolButton" TargetType="Button">
                <Setter Property="Padding" Value="9,6,9,6"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏：Windows 设置样式（logo + 名称，Mica 贯穿） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0,160,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleLogo" Width="16" Height="16" Stretch="Uniform"/>
                <TextBlock Text="QookiL" Style="{ThemeResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 主内容 -->
        <Grid Grid.Row="1" Padding="22,8,22,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 控制栏 -->
            <Border Style="{StaticResource Card}" Grid.Row="0" Padding="16,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="11" Height="11" Fill="#9E9E9E" VerticalAlignment="Center"/>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText" Text="服务未启动" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatusSub" Text="启动后，同一局域网的设备用浏览器即可访问"
                                       FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="端口" FontSize="12.5" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <NumberBox x:Name="PortBox" Value="5188" Minimum="1" Maximum="65535"
                                   Width="124" SpinButtonPlacementMode="Compact"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="启动时自动开启" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ToggleSwitch x:Name="AutoStartToggle" OnContent="" OffContent="" MinWidth="44"
                                      Toggled="OnAutoStartToggled"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="RefreshBtn" Click="OnRefreshUrls"
                                Style="{StaticResource ToolButton}" ToolTipService.ToolTip="刷新地址与二维码">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        </Button>
                        <Button Click="OnDiagnostics"
                                Style="{StaticResource ToolButton}" ToolTipService.ToolTip="连接诊断：防火墙状态与排查建议">
                            <FontIcon Glyph="&#xE713;" FontSize="14"/>
                        </Button>
                    </StackPanel>

                    <Button x:Name="StartStopBtn" Grid.Column="4" Click="OnStartStop"
                            Style="{ThemeResource AccentButtonStyle}" MinWidth="110" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="StartStopIcon" Glyph="&#xE768;" FontSize="14"/>
                            <TextBlock x:Name="StartStopText" Text="启动服务"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 主体两列 -->
            <Grid Grid.Row="1" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：共享列表卡片 -->
                <Border Style="{StaticResource Card}" Grid.Column="0" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Padding="16,12,12,10" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="共享的文件和文件夹" Style="{StaticResource CardHeader}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Click="OnAddFiles" Style="{StaticResource ToolButton}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                    <TextBlock Text="添加文件" FontSize="12.5"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Click="OnAddFolder" Style="{StaticResource ToolButton}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="13"/>
                                    <TextBlock Text="添加文件夹" FontSize="12.5"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Click="OnClearAll" Style="{StaticResource ToolButton}"
                                    ToolTipService.ToolTip="清空共享列表">
                                <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Margin="8,0,8,4">
                            <ListView x:Name="SharesList" SelectionMode="Extended" AllowDrop="True"
                                      Background="Transparent" BorderThickness="0"
                                      DragOver="OnListDragOver" Drop="OnListDrop" KeyDown="SharesList_KeyDown">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:SharedItemView">
                                        <Grid ColumnSpacing="12" Padding="6,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="8"
                                                    Background="{ThemeResource SystemControlForegroundBaseLowBrush}">
                                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="15"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                <TextBlock Text="{x:Bind Meta}" FontSize="11" MaxLines="1"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Click="OnRemoveItem" Tag="{x:Bind Item.Id}"
                                                    Background="Transparent" BorderThickness="0" Padding="6,4,6,4"
                                                    VerticalAlignment="Center" ToolTipService.ToolTip="移除">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="8" Opacity="0.5" IsHitTestVisible="False">
                                <FontIcon Glyph="&#xE8B7;" FontSize="38"/>
                                <TextBlock Text="还没有共享任何内容" HorizontalAlignment="Center"/>
                                <TextBlock Text="把文件或文件夹拖到这里，或使用右上方按钮添加" FontSize="11.5"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" BorderThickness="0,1,0,0"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Padding="16,10,16,12">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="13"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="接收文件夹" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBox x:Name="UploadDirBox" Grid.Column="1" FontSize="11.5"
                                         IsReadOnly="True" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Click="OnPickUploadDir"
                                        Style="{StaticResource ToolButton}" Content="更改"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 右：二维码 / 地址 / 传输记录 -->
                <Grid Grid.Column="1" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Grid.Row="0">
                        <StackPanel Spacing="10">
                            <Border Background="White" CornerRadius="10" Padding="10"
                                    Width="172" Height="172" HorizontalAlignment="Center"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Image x:Name="QrImage" Stretch="Uniform"/>
                            </Border>
                            <TextBlock x:Name="QrHint" Text="启动服务后显示二维码" HorizontalAlignment="Center"
                                       FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Row="1" Padding="14,12,14,12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="访问地址" Style="{StaticResource CardHeader}"/>
                            <StackPanel x:Name="UrlPanel" Spacing="7"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Row="2" Padding="14,12,14,12">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="传输记录" Style="{StaticResource CardHeader}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Click="OnClearLog" Style="{StaticResource ToolButton}"
                                        ToolTipService.ToolTip="清空记录">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                </Button>
                            </Grid>
                            <Grid Grid.Row="1">
                                <ListView x:Name="LogList" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:TransferLogView">
                                            <Grid ColumnSpacing="10" Padding="2,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" CornerRadius="7"
                                                        Background="{x:Bind BadgeBrush}">
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" Foreground="White"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="12" MaxLines="1"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{x:Bind Sub}" FontSize="10.5" MaxLines="1"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{x:Bind Size}" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="LogEmptyHint" Text="暂无传输记录" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <InfoBar x:Name="InfoBar" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                     Margin="0,0,0,4" IsOpen="False" CornerRadius="8"/>
        </Grid>
    </Grid>
</Window>
